{
  "version": 1,
  "author": "Sofy Salsabila",
  "editor": "Sofy",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": -90,
      "left": 260,
      "attrs": { "temperature": "25", "humidity": "50" }
    },
    { "type": "wokwi-photoresistor-sensor", "id": "ldr1", "top": 20, "left": 260, "attrs": {} },
    { "type": "wokwi-relay-module", "id": "relay1", "top": 134.6, "left": 259.2, "attrs": {} },
    { "type": "wokwi-resistor", "id": "r1", "top": 260, "left": 240, "attrs": { "value": "220" } },
    { "type": "wokwi-led", "id": "led1", "top": 250, "left": 360, "attrs": { "color": "red" } }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],
    [ "dht1:VCC", "esp:3V3", "red", [ "h-60", "v120" ] ],
    [ "dht1:SDA", "esp:D13", "green", [ "h-40", "v170" ] ],
    [ "dht1:GND", "esp:GND.1", "black", [ "h-80", "v230" ] ],
    [ "ldr1:VCC", "esp:3V3", "red", [ "v40", "h-200" ] ],
    [ "ldr1:GND", "esp:GND.1", "black", [ "v60", "h-220" ] ],
    [ "ldr1:AO", "esp:D34", "green", [ "h-80" ] ],
    [ "relay1:VCC", "esp:VIN", "red", [ "h-140", "v110" ] ],
    [ "relay1:GND", "esp:GND.1", "black", [ "h-160", "v70" ] ],
    [ "relay1:IN", "esp:D26", "orange", [ "h-100" ] ],
    [ "esp:D5", "r1:1", "green", [ "h110", "v80" ] ],
    [ "r1:2", "led1:A", "green", [] ],
    [ "led1:C", "esp:GND.1", "black", [ "v40", "h-300" ] ]
  ],
  "serialMonitor": { "display": "always" },
  "dependencies": {}
}